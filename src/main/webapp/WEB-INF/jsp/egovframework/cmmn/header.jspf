<%-- 정적 include 조각. 태그 선언은 IDE 검사용 (포함하는 페이지와 같은 URI라 중복 허용) --%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%--
	페이지가 설정하는 값: pageTitle(제목), menu(현재 메뉴), noPageHead(제목 영역 생략)
--%>
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><c:out value="${pageTitle}" /> | 공공시설 예약 (데모)</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/packages/pretendard-gov/dist/web/variable/pretendardvariable-gov-dynamic-subset.min.css">
<link rel="stylesheet" href="${ctx}/css/fclty.css">
</head>
<body>
<a class="skip" href="#content">본문 바로가기</a>

<div class="demo-bar">
	<div class="wrap">
		<span>포트폴리오용 데모 사이트입니다. 실제 기관·시설과 관계없습니다.</span>
		<div class="user">
			<c:choose>
				<c:when test="${empty login}">
					<a href="${ctx}/mber/loginView.do">로그인</a>
					<a href="${ctx}/mber/joinView.do">회원가입</a>
				</c:when>
				<c:otherwise>
					<span><c:out value="${login.mberNm}" />님<c:if test="${login.admin}"> (관리자)</c:if></span>
					<form method="post" action="${ctx}/mber/logout.do" class="inline">
						<input type="hidden" name="_csrf" value="<c:out value='${sessionScope.CSRF_TOKEN}'/>">
						<button type="submit" class="link">로그아웃</button>
					</form>
				</c:otherwise>
			</c:choose>
		</div>
	</div>
</div>

<header class="header">
	<div class="wrap">
		<a class="brand" href="${ctx}/main.do"><span class="brand-mark" aria-hidden="true">예</span>공공시설 예약</a>
		<nav class="gnb" aria-label="주 메뉴">
			<a href="${ctx}/fclty/list.do" ${menu eq 'fclty' ? 'aria-current="page"' : ''}>시설 찾기</a>
			<a href="${ctx}/notice/list.do" ${menu eq 'notice' ? 'aria-current="page"' : ''}>공지사항</a>
			<c:if test="${not empty login}"><a href="${ctx}/resve/myList.do" ${menu eq 'my' ? 'aria-current="page"' : ''}>나의 예약</a></c:if>
			<c:if test="${login.admin}">
				<span class="sep" aria-hidden="true"></span>
				<a href="${ctx}/admin/dashboard.do" ${menu eq 'adminDash' ? 'aria-current="page"' : ''}>대시보드</a>
				<a href="${ctx}/admin/resve/list.do" ${menu eq 'adminResve' ? 'aria-current="page"' : ''}>예약 관리</a>
				<a href="${ctx}/admin/fclty/list.do" ${menu eq 'adminFclty' ? 'aria-current="page"' : ''}>시설 관리</a>
			</c:if>
		</nav>
	</div>
</header>

<main id="content" tabindex="-1">
<c:if test="${not noPageHead}">
	<div class="page-head">
		<div class="wrap">
			<ol class="breadcrumb" aria-label="현재 위치">
				<li><a href="${ctx}/main.do">홈</a></li>
				<c:if test="${not empty crumbName}"><li><a href="${ctx}${crumbUrl}"><c:out value="${crumbName}" /></a></li></c:if>
				<li aria-current="page"><c:out value="${pageTitle}" /></li>
			</ol>
			<h1><c:out value="${pageTitle}" /></h1>
		</div>
	</div>
</c:if>
<div class="wrap">
<c:if test="${not empty message}"><p class="alert success" role="status"><c:out value="${message}" /></p></c:if>
<c:if test="${not empty errorMessage}"><p class="alert error" role="alert"><c:out value="${errorMessage}" /></p></c:if>
