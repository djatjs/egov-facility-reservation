<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd">

	<!-- 표준프레임워크 ID Generation 서비스: Oracle 시퀀스 기반 -->
	<bean name="fcltyIdGnrService" class="org.egovframe.rte.fdl.idgnr.impl.EgovSequenceIdGnrServiceImpl" destroy-method="destroy">
		<property name="dataSource" ref="dataSource" />
		<property name="query" value="SELECT SEQ_FCLTY.NEXTVAL FROM DUAL" />
	</bean>

	<bean name="resveIdGnrService" class="org.egovframe.rte.fdl.idgnr.impl.EgovSequenceIdGnrServiceImpl" destroy-method="destroy">
		<property name="dataSource" ref="dataSource" />
		<property name="query" value="SELECT SEQ_RESVE.NEXTVAL FROM DUAL" />
	</bean>

	<bean name="noticeIdGnrService" class="org.egovframe.rte.fdl.idgnr.impl.EgovSequenceIdGnrServiceImpl" destroy-method="destroy">
		<property name="dataSource" ref="dataSource" />
		<property name="query" value="SELECT SEQ_NOTICE.NEXTVAL FROM DUAL" />
	</bean>

</beans>
